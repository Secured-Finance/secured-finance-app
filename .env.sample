# Copy to .env.local for local development: cp .env.sample .env.local
# Values below target the development environment. In CI, build.yml writes
# .env.local from the GitHub Environment's vars/secrets instead.

# Deployment environment: development | staging | production (selects contracts and subgraphs)
SF_ENV=development
# Show the package version instead of the commit hash in the footer
NEXT_PUBLIC_USE_PACKAGE_VERSION=false

# Required. Comma-separated chain IDs the app can connect to
NEXT_PUBLIC_SUPPORTED_CHAIN_IDS=11155111,421614,43113,314159
# Chain IDs without a subgraph; subgraph-backed views are hidden on these chains
NEXT_PUBLIC_NON_SUBGRAPH_SUPPORTED_CHAIN_IDS=314159,43113
# Optional. Overrides the Filecoin mainnet (314) subgraph endpoint
NEXT_PUBLIC_SUBGRAPH_URL_314=

# Required. WalletConnect (Reown) project ID; ask the team or create one at cloud.reown.com
NEXT_PUBLIC_WALLET_CONNECT_ID=
# Public URL of the app, used as WalletConnect metadata (defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL=

# Required. Points program GraphQL API
NEXT_PUBLIC_GRAPHQL_SERVER_URL=https://dev-point-api.secured.finance/graphql
# Required. USDFC stablecoin app linked from the header
NEXT_PUBLIC_STABLECOIN_APP_URL=https://dev.usdfc.net/
# Vaults app linked from the header; the link is hidden when empty
NEXT_PUBLIC_VAULTS_APP_URL=https://dev-vaults.secured.finance
# Runtime config JSON (alert banners, referral message); banners are disabled when empty
NEXT_PUBLIC_RUNTIME_CONFIG_URL=https://config.secured.finance/dev.json

# RPC provider keys; the app falls back to public RPCs when empty
NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_ANKR_API_KEY=

# Analytics and integrations; disabled when empty
NEXT_PUBLIC_AMPLITUDE_API_KEY=
NEXT_PUBLIC_GOOGLE_ANALYTICS_TAG=
NEXT_PUBLIC_SQUID_WIDGET_INTEGRATOR_ID=

# Delisted currencies per chain ID (comma-separated symbols, empty if none)
NEXT_PUBLIC_DELISTED_CURRENCIES_1=
NEXT_PUBLIC_DELISTED_CURRENCIES_11155111=
NEXT_PUBLIC_DELISTED_CURRENCIES_314=
NEXT_PUBLIC_DELISTED_CURRENCIES_314159=
NEXT_PUBLIC_DELISTED_CURRENCIES_42161=
NEXT_PUBLIC_DELISTED_CURRENCIES_421614=

# Set to true to open the webpack bundle analyzer on build
# ANALYZE=true
